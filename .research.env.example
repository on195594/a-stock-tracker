# HOST research process only. Never pass this file to the Web container.
RESEARCH_SERVICE_ROOT=/absolute/private/new-research-requests
RESEARCH_SERVICE_SOCKET=/absolute/private/research-bridge/service.sock
RESEARCH_SERVICE_TOKEN=REPLACE_WITH_RANDOM_TOKEN_AT_LEAST_32_CHARACTERS
# Optional second channel for the local MCP server; must differ from the Web token.
# RESEARCH_SERVICE_MCP_TOKEN=REPLACE_WITH_ANOTHER_RANDOM_TOKEN_AT_LEAST_32_CHARACTERS
TUSHARE_TOKEN=REPLACE_WITH_AUTHORIZED_TOKEN
AUTOMATION_HERMES_RUNTIME=/absolute/path/to/installed/hermes-agent
# Alternatively use the installed pi provider runtime (takes precedence over Hermes).
# AUTOMATION_PI_RUNTIME=/absolute/path/to/node_modules/@earendil-works/pi-coding-agent
# AUTOMATION_PI_AGENT_DIR=/absolute/path/to/.pi/agent
# AUTOMATION_PI_EXTENSION=/absolute/path/to/pi-antigravity/src/index.ts
# Pin RESEARCH_PROVIDER / RESEARCH_MODEL to the chosen pi defaults at configuration time.
RESEARCH_PROVIDER=REPLACE_WITH_AUTHORIZED_PROVIDER
RESEARCH_MODEL=REPLACE_WITH_AUTHORIZED_MODEL

# Keep legacy until compatible readers are deployed and the new writer is authorized.
# evidence-first-v1 changes the quoted model-call path (3 normally, at most 5 per report).
RESEARCH_PIPELINE=legacy
# Set 0 for independent paid comparisons; retain every per-request charge ledger.
RESEARCH_RESPONSE_CACHE=1
