# HOST MCP server only (python -m a_stock_tracker.mcp_server). Keep mode 0600.
# No market/model credentials; the MCP server only talks to the private receiver socket.
RESEARCH_SERVICE_SOCKET=/absolute/private/research-bridge/service.sock
RESEARCH_SERVICE_MCP_TOKEN=REPLACE_WITH_SAME_TOKEN_AS_HOST_RESEARCH_SERVICE_MCP_TOKEN
# RESEARCH_SERVICE_URL=http://research
