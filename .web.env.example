# Production GitHub OAuth Configuration
# 1. Register GitHub OAuth App at: https://github.com/settings/developers
#    - Homepage URL: https://stock.keyi.win
#    - Authorization callback URL: https://stock.keyi.win/oauth_callback
# 2. Get your numeric GitHub User ID:
#    curl -s https://api.github.com/users/<your-github-username> | jq .id

GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_ALLOWED_USER_ID=your_numeric_github_id

# Optional admin password login (issues the same owner session as GitHub login).
# Leave ADMIN_PASSWORD empty to keep it off. No hashing, rate limiting or lockout:
# generate a long random password, e.g. python3 -c 'import secrets; print(secrets.token_urlsafe(24))'
# ADMIN_LOGIN_SCOPE: local (default; loopback or ADMIN_ALLOWED_IPS sources only) or any (public).
# ADMIN_ALLOWED_IPS: comma-separated addresses/networks, e.g. this host's egress IP
#   (curl -4 -s https://stock.keyi.win/cdn-cgi/trace | grep ^ip=).
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_LOGIN_SCOPE=local
ADMIN_ALLOWED_IPS=
# ADMIN_TRUSTED_PROXIES: reverse proxies whose X-Real-IP is believed (container name, address
#   or network); from any other peer the header is ignored. Production: nginx
ADMIN_TRUSTED_PROXIES=

# Optional Research Bridge Configuration (when RESEARCH_WEB_ENABLED=1)
# Web bridge configuration only; no market/model credentials or artifact mounts.
RESEARCH_BRIDGE_DIR=/absolute/private/research-bridge
RESEARCH_SERVICE_TOKEN=REPLACE_WITH_SAME_RANDOM_TOKEN_AS_HOST_SERVICE
