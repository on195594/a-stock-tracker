# Production GitHub OAuth Configuration
# 1. Register GitHub OAuth App at: https://github.com/settings/developers
#    - Homepage URL: https://stock.keyi.win
#    - Authorization callback URL: https://stock.keyi.win/oauth_callback
# 2. Get your numeric GitHub User ID:
#    curl -s https://api.github.com/users/<your-github-username> | jq .id

GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_ALLOWED_USER_ID=your_numeric_github_id

# Optional: absolute read-only opportunity publication directory.
# Requires a separately authorized batch and an actual read-only container mount.
# Direct process: set OPPORTUNITY_ROOT=/absolute/private/opportunities
# Docker Compose: set OPPORTUNITY_HOST_ROOT=/absolute/private/opportunities
# (docker-compose.opportunities.yml binds it to OPPORTUNITY_ROOT=/app/opportunities)
# OPPORTUNITY_ROOT=/app/opportunities
# OPPORTUNITY_HOST_ROOT=/absolute/private/opportunities
